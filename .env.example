# GitHub App (set these locally; never commit real values)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Production default: DynamoDB table with pk/sk and issue-key-index.
DYNAMODB_TABLE=
ISSUEMATCH_STORAGE=dynamodb
AWS_REGION=us-east-1

# Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
