# GitHub App (set these locally; never commit real values)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Candidate storage
DYNAMODB_TABLE=
ISSUEMATCH_STORAGE=dynamodb
AWS_REGION=us-east-1

# Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# LLM Providers (comma-separated keys)
GROQ_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
COHERE_API_KEYS=
NVIDIA_API_KEYS=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Role-specific Scout/Verifier LLM configuration
# Legacy single-provider mode
SCOUT_PROVIDER=
SCOUT_MODEL_ID=
VERIFIER_PROVIDER=
VERIFIER_MODEL_ID=

# Multi-provider pool mode (comma-separated: GROQ,GEMINI,MISTRAL,NVIDIA,COHERE)
# Cannot be set simultaneously with SCOUT_PROVIDER / VERIFIER_PROVIDER
SCOUT_PROVIDERS=
VERIFIER_PROVIDERS=

# Per-provider role model IDs for pool mode
SCOUT_GROQ_MODEL_ID=
SCOUT_GEMINI_MODEL_ID=
SCOUT_MISTRAL_MODEL_ID=
SCOUT_NVIDIA_MODEL_ID=

VERIFIER_GROQ_MODEL_ID=
VERIFIER_GEMINI_MODEL_ID=
VERIFIER_MISTRAL_MODEL_ID=
VERIFIER_NVIDIA_MODEL_ID=

# Timeout Configuration
LLM_TIMEOUT_SECONDS=60
SCOUT_TIMEOUT=
VERIFIER_TIMEOUT=

# Scout/Verifier SQLite Storage
ISSUE_ANALYZER_DB_PATH=
WEBHOOK_JOB_LEASE_SECONDS=60
WEBHOOK_MAX_ATTEMPTS=3
STALE_RESERVATION_SECONDS=300

# Live Webhook Receiver Server
HOST=0.0.0.0
PORT=8000

# Live Provider E2E Sandbox Configuration
RUN_LIVE_SCOUT_E2E=0
LIVE_E2E_OWNER=
LIVE_E2E_REPO=
LIVE_E2E_EXPECTED_REPO_ID=
LIVE_E2E_INSTALLATION_ID=
LIVE_E2E_BEFORE_SHA=
LIVE_E2E_COMMIT_SHA=
LIVE_E2E_ALLOW_ISSUE_WRITES=0
LIVE_E2E_EXPECT_ISSUE_CREATION=0
LIVE_E2E_EXPECT_AUTHORIZED_FINDING=0
LIVE_E2E_EXPECTED_CHANGED_FILE=

RUN_MODEL_EVALUATION=0

# GitHub OAuth App (for user login — different from the GitHub App above)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:5173

# Session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
