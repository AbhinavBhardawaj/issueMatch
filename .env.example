# GitHub App (set these locally; never commit real values)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Candidate storage
DYNAMODB_TABLE=
ISSUEMATCH_STORAGE=dynamodb
AWS_REGION=us-east-1

# Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# LLM Providers (comma-separated keys)
GROQ_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
COHERE_API_KEYS=
NVIDIA_API_KEYS=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Role-specific Scout/Verifier LLM configuration
SCOUT_PROVIDER=
SCOUT_MODEL_ID=
VERIFIER_PROVIDER=
VERIFIER_MODEL_ID=

# Timeout Configuration
LLM_TIMEOUT_SECONDS=60
SCOUT_TIMEOUT=
VERIFIER_TIMEOUT=

STALE_RESERVATION_SECONDS=300

# Live Provider E2E Sandbox Configuration
RUN_LIVE_SCOUT_E2E=0
LIVE_E2E_OWNER=
LIVE_E2E_REPO=
LIVE_E2E_EXPECTED_REPO_ID=
LIVE_E2E_INSTALLATION_ID=
LIVE_E2E_BEFORE_SHA=
LIVE_E2E_COMMIT_SHA=
LIVE_E2E_ALLOW_ISSUE_WRITES=0
LIVE_E2E_EXPECT_ISSUE_CREATION=0
LIVE_E2E_EXPECTED_CHANGED_FILE=

RUN_MODEL_EVALUATION=0
