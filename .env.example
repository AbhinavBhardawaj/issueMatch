# GitHub App (set these locally; never commit real values)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Candidate storage
DYNAMODB_TABLE=
ISSUEMATCH_STORAGE=dynamodb
AWS_REGION=
# Set AWS_REGION to the Region where your DynamoDB table actually exists.
# AWS credentials are resolved by Boto3 in the backend process. For local use,
# select an existing AWS_PROFILE (and log in for SSO), or use an IAM role.
# Do not put access keys in this file or commit them to the repository.

# Local Ollama
ISSUEMATCH_ANALYSIS_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# LLM Providers (comma-separated keys)
GROQ_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
COHERE_API_KEYS=
NVIDIA_API_KEYS=
# NVIDIA_API_KEYS is used by Scout; it does not switch candidate analysis from Ollama.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Role-specific Scout/Verifier LLM configuration
SCOUT_PROVIDER=
SCOUT_MODEL_ID=
VERIFIER_PROVIDER=
VERIFIER_MODEL_ID=

LLM_TIMEOUT_SECONDS=60
STALE_RESERVATION_SECONDS=300

# Live Provider E2E Sandbox Configuration
RUN_LIVE_SCOUT_E2E=0
LIVE_E2E_OWNER=
LIVE_E2E_REPO=
LIVE_E2E_EXPECTED_REPO_ID=
LIVE_E2E_ALLOW_ISSUE_WRITES=0

RUN_MODEL_EVALUATION=0
