# .env.example
# Groq (up to 5 keys, comma-separated)
GROQ_API_KEYS=

# Gemini (up to 3 keys, comma-separated)
GEMINI_API_KEYS=

# Mistral (up to 3 keys, comma-separated)
MISTRAL_API_KEYS=

# Cohere (up to 3 keys, comma-separated)
COHERE_API_KEYS=

# NVIDIA NIM (comma-separated keys)
NVIDIA_API_KEYS=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Existing env vars (unchanged)
LLM_TIMEOUT_SECONDS=60
STALE_RESERVATION_SECONDS=300

# Live Provider E2E Sandbox Configuration
RUN_LIVE_SCOUT_E2E=0
LIVE_E2E_OWNER=
LIVE_E2E_REPO=
LIVE_E2E_EXPECTED_REPO_ID=
LIVE_E2E_ALLOW_ISSUE_WRITES=0

RUN_MODEL_EVALUATION=0

